  {
    "id": "clause:GB30871:6.2",
    "rawId": "clause:GB30871:6.2",
    "name": "GB30871 6.2",
    "kind": "SAFETY_CLAUSE",
    "domain": "化工安全",
    "sourceFile": "seed",
    "properties": {
      "clauseNo": "6.2",
      "regulationCode": "GB30871",
      "text": "动火作业前应进行气体检测，确认可燃气体浓度符合要求。",
      "mandatory": true
    },
    "domainCategory": "supporting",
    "canonicalId": "clause:GB30871:6.2"
  },
  {
    "id": "clause:GB30871:6.3",
    "rawId": "clause:GB30871:6.3",
    "name": "GB30871 6.3",
    "kind": "SAFETY_CLAUSE",
    "domain": "化工安全",
    "sourceFile": "seed",
    "properties": {
      "clauseNo": "6.3",
      "regulationCode": "GB30871",
      "text": "动火作业应办理动火作业票并经审批。",
      "mandatory": true
    },
    "domainCategory": "supporting",
    "canonicalId": "clause:GB30871:6.3"
  },
  {
    "id": "clause:GB30871:6.4",
    "rawId": "clause:GB30871:6.4",
    "name": "GB30871 6.4",
    "kind": "SAFETY_CLAUSE",
    "domain": "化工安全",
    "sourceFile": "seed",
    "properties": {
      "clauseNo": "6.4",
      "regulationCode": "GB30871",
      "text": "动火作业应设置专人监护。",
      "mandatory": true
    },
    "domainCategory": "supporting",
    "canonicalId": "clause:GB30871:6.4"
  },
  {
    "id": "clause:GB30871:8.2",
    "rawId": "clause:GB30871:8.2",
    "name": "GB30871 8.2",
    "kind": "SAFETY_CLAUSE",
    "domain": "化工安全",
    "sourceFile": "seed",
    "properties": {
      "clauseNo": "8.2",
      "regulationCode": "GB30871",
      "text": "受限空间作业前应进行隔离、清洗、置换。",
      "mandatory": true
    },
    "domainCategory": "supporting",
    "canonicalId": "clause:GB30871:8.2"
  },
  {
    "id": "clause:GB30871:8.3",
    "rawId": "clause:GB30871:8.3",
