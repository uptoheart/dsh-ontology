    "kind": "SAFETY_CLAUSE",
    "domain": "化工安全",
    "sourceFile": "seed",
    "properties": {
      "clauseNo": "9.2",
      "regulationCode": "GB30871",
      "text": "高处作业应正确佩戴安全带。",
      "mandatory": true
