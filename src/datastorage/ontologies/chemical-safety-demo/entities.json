    "kind": "SAFETY_CLAUSE",
    "domain": "化工安全",
    "sourceFile": "seed",
    "properties": {
      "clauseNo": "8.3",
      "regulationCode": "GB30871",
      "text": "受限空间作业应检测氧含量与有毒有害气体。",
      "mandatory": true
    },
    "domainCategory": "supporting",
    "canonicalId": "clause:GB30871:8.3"
  },
  {
    "id": "clause:GB30871:9.2",
